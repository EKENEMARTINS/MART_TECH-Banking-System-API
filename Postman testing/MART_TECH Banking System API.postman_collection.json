    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstName\": \"Enter firstName\",\r\n    \"lastName\": \"Enter lastName\",\r\n    \"email\": \"firstName@example.com\",\r\n    \"password\": \"1234567890\",\r\n    \"phone\": \"09000000000\",\r\n    \"dob\": \"0000-00-00\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.token) {\r",
                  "    pm.collectionVariables.set(\r",
                  "        \"customerToken\",\r",
                  "        response.token\r",
                  "    );\r",
                  "}\r",
                  "pm.test(\"Login successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"JWT returned\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response.token).to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"firstname@example.com\",\r\n    \"password\": \"1234567890\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.transaction?.transactionId) {\r",
                  "    pm.collectionVariables.set(\r",
                  "        \"transactionId\",\r",
                  "        response.transaction.transactionId\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Transfer successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Transaction reference returned\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(\r",
                  "        response.transaction.transactionId\r",
                  "    ).to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"to\": \"{{recipientAccount}}\",\r\n    \"amount\": 1000\r\n}\r\n\r\n//Copy and paste the recipient account number in the recipientAccount variable section of the MART_TECH Banking System collection",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transaction",
                "transfer"
              ]
            }
          },
          "response": []
        },
